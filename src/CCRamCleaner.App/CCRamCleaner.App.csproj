<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CCRamCleaner</AssemblyName>
    <RootNamespace>CCRamCleaner.App</RootNamespace>
    <Version>0.1.0</Version>
    <!-- MVVM toolkit source generators can emit advisory warnings; keep the UI shell lenient. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WFO0003 targets WinForms apps; this is a WPF app (WinForms only for NotifyIcon) and WPF reads DPI awareness from the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF + WinForms (tray icon) together: avoid ambiguous Application/MessageBox/etc. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CCRamCleaner.Core\CCRamCleaner.Core.csproj" />
  </ItemGroup>
</Project>
